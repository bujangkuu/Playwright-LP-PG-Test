# ===================================================================
# LP PG Platform - Playwright Automation Test Suite Environment
# ===================================================================
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Fill in the required credentials and configuration values.
# 3. If testing against a freshly migrated DB, run: `npx playwright test tests/api/qa-environment-setup.spec.ts`
# ===================================================================

# Environment URLs
API_BASE_URL=https://pg-api-dev.lintaspay.com
BASE_URL=https://pg-dashboard-dev.lintaspay.com

# Master Superadmin Credentials (for provisioning)
ADMIN_USER=internaladmin
ADMIN_PASS=your_master_password_here

# -------------------------------------------------------------------
# Primary QA Tenant (QA Org 1)
# -------------------------------------------------------------------
QA_PRIMARY_ORG_ID=5abeba06-3a2e-4b06-9fc6-e0f4ddbcbc08
QA_PRIMARY_ORG_CODE=QAORG
QA_PRIMARY_ORG_NAME=QA Org
QA_PRIMARY_WALLET_ID=2daa41c9-4545-466a-be90-c2d3c6151de8
QA_PRIMARY_MERCHANT_ID=1cfc36f9-385a-4a42-b32c-ad5d537bb16a
QA_PRIMARY_MERCHANT_NAME=QA Merchant

QA_INTERNAL_ADMIN_USER=qaadminint
QA_INTERNAL_ADMIN_PASS=your_qa_password_here
QA_ORG_ADMIN_USER=qaadminorg
QA_ORG_ADMIN_PASS=your_qa_password_here
QA_MERCHANT_ADMIN_USER=qaadminmerch
QA_MERCHANT_ADMIN_PASS=your_qa_password_here
QA_INACTIVE_USER=qainactiveorg
QA_INACTIVE_PASS=your_qa_password_here

# -------------------------------------------------------------------
