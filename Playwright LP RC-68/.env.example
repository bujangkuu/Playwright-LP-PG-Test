# -------------------------------------------------------------------
# Optional & Dedicated Edge-Case Test Users
# -------------------------------------------------------------------
FIGMA_API_KEY=your_figma_api_key_here

# Dedicated Merchant XSS Test User (Profile & Stored XSS Testing)
QA_XSS_MERCHANT_ID=
QA_XSS_MERCHANT_NAME=
QA_XSS_MERCHANT_USER_ID=
QA_XSS_MERCHANT_USER=qamcxss_test
QA_XSS_MERCHANT_PASS=your_xss_password_here
QA_XSS_MERCHANT_EMAIL=qamcxss_test@lintaspay.com
